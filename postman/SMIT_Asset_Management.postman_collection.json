    {
      "name": "Authentication & RBAC",
      "item": [
        {
          "name": "1. Register (Campus Manager with Campus Scoping)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.token) {",
                  "    pm.collectionVariables.set('token', response.token);",
                  "    console.log('JWT Token saved to collection variable: token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ali Khan\",\n  \"email\": \"ali.khan@smit.edu.pk\",\n  \"password\": \"Password123!\",\n  \"phone\": \"+923001234567\",\n  \"department\": \"IT Support\",\n  \"designation\": \"Campus Manager\",\n  \"role\": \"CAMPUS_MANAGER\",\n  \"campusScope\": [\"{{authorizedCampusId}}\"],\n  \"isGlobalScope\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registers a new user scoped to specific campus ID(s). Automatically captures the returned JWT into the collection variable `token`."
          },
          "response": []
        },
        {
          "name": "2. Register (Super Admin - Global Scope)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.token) {",
                  "    pm.collectionVariables.set('token', response.token);",
                  "    console.log('Admin Token saved to collection variable: token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"System Administrator\",\n  \"email\": \"superadmin@smit.edu.pk\",\n  \"password\": \"AdminSecret2026!\",\n  \"department\": \"Central Operations\",\n  \"designation\": \"Head of IT Infrastructure\",\n  \"role\": \"SUPER_ADMIN\",\n  \"isGlobalScope\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registers a Super Admin account with global scope across all campuses."
          },
          "response": []
        },
        {
          "name": "3. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.token) {",
                  "    pm.collectionVariables.set('token', response.token);",
                  "    console.log('JWT Token updated in collection variable: token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@smit.edu.pk\",\n  \"password\": \"AdminSecret2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates user credentials and sets the JWT token variable automatically."
          },
          "response": []
        },
        {
          "name": "4. Get Current User Profile (/me)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Returns the authenticated user profile with resolved role, permissions, and populated campus scopes."
          },
          "response": []
        },
        {
          "name": "5. Verify Campus Access (Authorized Campus)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/test-campus-access/{{authorizedCampusId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "test-campus-access", "{{authorizedCampusId}}"]
            },
            "description": "Tests Campus Scoping middleware with an authorized campus ID. Expects 200 OK."
          },
          "response": []
        },
        {
          "name": "6. Verify Campus Access (Forbidden Campus - Expect 403)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/test-campus-access/{{forbiddenCampusId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "test-campus-access", "{{forbiddenCampusId}}"]
            },
            "description": "Tests Campus Scoping middleware with an unauthorized campus ID. Expects 403 Forbidden with access denial error."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Asset Master & QR Tokens",
      "item": [
        {
          "name": "1. Create Asset (Sequential ID & Opaque QR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data._id) {",
                  "    pm.collectionVariables.set('assetId', res.data._id);",
                  "    pm.collectionVariables.set('assetQrToken', res.data.qrToken);",
                  "    console.log('Saved assetId:', res.data._id);",
                  "    console.log('Saved assetQrToken:', res.data.qrToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dell Latitude 5420 Laptop\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"brand\": \"Dell\",\n  \"modelNumber\": \"Latitude 5420\",\n  \"serialNumber\": \"SN-DELL-883921\",\n  \"status\": \"AVAILABLE\",\n  \"condition\": \"NEW\",\n  \"location\": {\n    \"campusId\": \"{{authorizedCampusId}}\",\n    \"buildingId\": \"{{buildingId}}\",\n    \"roomId\": \"{{roomId}}\"\n  },\n  \"specs\": {\n    \"ram_gb\": 16,\n    \"processor\": \"Intel Core i7-1185G7\",\n    \"storage\": \"512GB NVMe SSD\",\n    \"mac_address\": \"00:1A:2B:3C:4D:5E\"\n  },\n  \"financials\": {\n    \"purchaseCost\": 195000,\n    \"vendor\": \"Dell Pakistan Official\",\n    \"invoiceNumber\": \"INV-SMIT-2026-001\"\n  },\n  \"notes\": \"Allocated for Software Development Lab\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/assets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assets"]
            },
            "description": "Creates a master asset with system-generated permanent Asset ID (e.g. SMIT-LAP-000001) and opaque cryptographic QR token."
          },
          "response": []
        },
        {
          "name": "2. List Assets (Filters, Pagination & Scoping)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assets?page=1&limit=10&status=AVAILABLE&sortBy=createdAt&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assets"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "AVAILABLE" },
                { "key": "campusId", "value": "{{authorizedCampusId}}", "disabled": true },
                { "key": "categoryId", "value": "{{categoryId}}", "disabled": true },
                { "key": "search", "value": "Dell", "disabled": true },
                { "key": "sortBy", "value": "createdAt" },
                { "key": "sortOrder", "value": "desc" }
              ]
            },
            "description": "Lists assets with campus scoping, category and status filtering, text search, and pagination."
          },
          "response": []
        },
        {
          "name": "3. Get Single Asset by ID (With History Timeline)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assets/{{assetId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assets", "{{assetId}}"]
            },
            "description": "Returns full asset profile including populated location hierarchy and chronological history/timeline."
          },
          "response": []
        },
        {
          "name": "4. Update Asset (Status & Assignment)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ASSIGNED\",\n  \"condition\": \"EXCELLENT\",\n  \"remarks\": \"Assigned to Senior Trainer for AI Bootcamp\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/assets/{{assetId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assets", "{{assetId}}"]
            },
            "description": "Updates asset properties and automatically appends a STATUS_CHANGED history audit event."
          },
          "response": []
        },
        {
          "name": "5. Scan QR Code Token (Public / Unauthenticated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assets/qr/{{assetQrToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assets", "qr", "{{assetQrToken}}"]
            },
            "description": "Simulates a public phone scanning the QR token. Returns non-sensitive summary without exposing confidential financial or personal data."
          },
          "response": []
        },
        {
          "name": "6. Scan QR Code Token (Authenticated Technician / Manager)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assets/qr/{{assetQrToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assets", "qr", "{{assetQrToken}}"]
            },
            "description": "Scans QR token with technician or manager Bearer token. Returns complete specifications and maintenance history."
          },
          "response": []
        },
        {
          "name": "7. Bulk Intake / Import Assets",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assets\": [\n    {\n      \"name\": \"HP LaserJet Pro MFP 4103dw\",\n      \"categoryId\": \"{{categoryId}}\",\n      \"brand\": \"HP\",\n      \"modelNumber\": \"4103dw\",\n      \"serialNumber\": \"SN-HP-001928\",\n      \"status\": \"AVAILABLE\",\n      \"condition\": \"NEW\",\n      \"location\": {\n        \"campusId\": \"{{authorizedCampusId}}\",\n        \"buildingId\": \"{{buildingId}}\",\n        \"roomId\": \"{{roomId}}\"\n      },\n      \"specs\": {\n        \"print_speed_ppm\": 42,\n        \"duplex\": true,\n        \"connectivity\": \"Ethernet, Wi-Fi, USB\"\n      }\n    },\n    {\n      \"name\": \"Cisco Catalyst 2960-X Switch\",\n      \"categoryId\": \"{{categoryId}}\",\n      \"brand\": \"Cisco\",\n      \"modelNumber\": \"WS-C2960X-48TS-L\",\n      \"serialNumber\": \"SN-CISCO-882190\",\n      \"status\": \"AVAILABLE\",\n      \"condition\": \"NEW\",\n      \"location\": {\n        \"campusId\": \"{{authorizedCampusId}}\",\n        \"buildingId\": \"{{buildingId}}\",\n        \"roomId\": \"{{roomId}}\"\n      },\n      \"specs\": {\n        \"ports\": 48,\n        \"speed\": \"10/100/1000 Gigabit\",\n        \"poe\": false\n      }\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/assets/import",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assets", "import"]
            },
            "description": "Performs bulk intake of assets with row-level validation, duplicate checking, and auto-generated sequential tags and QR tokens."
          },
          "response": []
        },
        {
          "name": "8. Soft-Delete / Retire Asset",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assets/{{assetId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assets", "{{assetId}}"]
            },
            "description": "Soft-deletes and retires an asset while preserving the audit timeline in AssetHistory."
          },
          "response": []
        }
      ]
    }
  ]
