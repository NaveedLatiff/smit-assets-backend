          "name": "1. Register (Campus Manager with Campus Scoping)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.token) {",
                  "    pm.environment.set('token', response.token);",
                  "    pm.collectionVariables.set('token', response.token);",
                  "    console.log('JWT Token saved to environment and collection: token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
