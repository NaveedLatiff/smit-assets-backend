# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Configuration
# Local: mongodb://127.0.0.1:27017/smit_assets_db
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/smit_assets_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smit_assets_db

# CORS Configuration (comma-separated origins or * for open during development)
ALLOWED_ORIGINS=*

# JWT / Auth Secret (for upcoming auth modules)
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
