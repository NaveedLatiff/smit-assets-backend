{
  "name": "smit-assets-backend",
  "version": "1.0.0",
  "description": "Asset Inventory & IT Helpdesk Management System - Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test:db": "tsx src/scripts/testConnection.ts",
    "test:auth": "tsx src/scripts/testAuth.ts",
    "test:assets": "tsx src/scripts/testAssets.ts",
    "seed": "tsx src/scripts/seedData.ts",
    "build": "rimraf dist && tsc",
